# copy to .env.local for local dev; set the same keys in vercel for production

# random 32+ char string: openssl rand -base64 32
BETTER_AUTH_SECRET=
# the site's public url (no trailing slash)
BETTER_AUTH_URL=http://localhost:3000

# postgres connection string from orzzn / neon / any postgres host.
# leave empty locally to use the embedded database in .data/
DATABASE_URL=

# email (resend.com). leave empty locally: emails print in the terminal instead
RESEND_API_KEY=
EMAIL_FROM="Polu <no-reply@your-domain.com>"

# google sign-in (optional). redirect uri: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# public site url used for open graph links
NEXT_PUBLIC_SITE_URL=https://polu-rho.vercel.app
